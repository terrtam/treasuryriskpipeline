# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=treasury
POSTGRES_USER=treasury
POSTGRES_PASSWORD=change-me
POSTGRES_SSLMODE=prefer

# Elasticsearch
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_INDEX=treasury_audit_logs

# Spark
SPARK_APP_NAME=TreasuryPipeline
SPARK_MASTER=local[*]
SPARK_SQL_SHUFFLE_PARTITIONS=8
SPARK_WAREHOUSE_DIR=
